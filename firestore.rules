rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVES ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- REUSABLE VALIDATORS ---
    function isValidUser(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isValidPersona(data) {
      return data.keys().hasAll(['dimensions'])
        && data.dimensions is map;
    }

    // --- COLLECTIONS ---

    // USERS
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) 
        && incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'pae'])
        && (incoming().updatedAt == request.time);

      // PERSONA SUBCOLLECTION
      match /persona/{version} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPersona(incoming());
      }

      // TRAJECTORIES
      match /trajectories/{planId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId);
      }

      // SESSIONS
      match /sessions/{sessionId} {
        allow list: if isOwner(userId);
        allow get, write: if isOwner(userId);
      }
    }

    // CAREER KNOWLEDGE GRAPH (Read-only for users)
    match /careers/{careerId} {
      allow get, list: if isSignedIn();
    }

    // CAREER PASSPORTS (B2B Bridge)
    // Shared with a partnerId field or via specific access logic
    match /passports/{passportId} {
      allow get: if isSignedIn(); // In a real app, we'd check if the recruiter has a valid contract
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

  }
}
